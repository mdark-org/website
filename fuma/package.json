{
  "name": "fuma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "vp preview",
    "db:gen": "pnpm drizzle-kit generate && node scripts/sync-d1-migration.ts",
    "migrate:local": "cf d1 migrations apply 8e3e8697-7153-472c-97b5-9e7c1ef352c2 --local --dir drizzle/d1",
    "migrate:development": "cf d1 migrations apply 8e3e8697-7153-472c-97b5-9e7c1ef352c2 --dir drizzle/d1",
    "migrate:production": "cf d1 migrations apply b064e2bf-7210-41dd-90f1-be5b4bf8b864 --dir drizzle/d1",
    "build:preview": "vp build --mode=development",
    "deploy:preview": "pnpm run build:preview && cf previews deploy --prebuilt --mode=development",
    "deploy:development": "pnpm run build:preview && cf deploy --prebuilt --mode=development --secrets-file=.secret.development",
    "deploy:production": "pnpm run build && cf deploy --prebuilt --mode=production --secrets-file=.secret.production",
    "dev": "vp dev --mode=development",
    "build": "vp build --mode=production"
  },
  "dependencies": {
    "@algolia/requester-fetch": "^5.60.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@fontsource/inter": "^5.2.8",
    "@fuma-comment/react": "1.5.1",
    "@fuma-comment/server": "^1.5.1",
    "@repo/source": "workspace:*",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@uploadthing/react": "^7.3.3",
    "algoliasearch": "^5.59.0",
    "any-date-parser": "^2.2.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "catalog:drizzle",
    "feed": "^5.2.1",
    "fumadocs-core": "catalog:fumadocs",
    "fumadocs-ui": "catalog:fumadocs",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "4.13.7",
    "lucide-react": "1.52.0",
    "micromatch": "^4.0.8",
    "p-limit": "^7.3.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.11.0",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "uploadthing": "^7.7.4",
    "vfile": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/micromatch": "^4.0.10",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "catalog:",
    "dotenv": "^18.0.5",
    "drizzle-kit": "catalog:drizzle",
    "miniflare": "5.20260930.0-alpha",
    "p-limit": "^7.3.3",
    "react-medium-image-zoom": "^5.4.5",
    "tailwindcss": "catalog:tailwindcss",
    "use-sync-external-store": "^1.7.0",
    "vite": "catalog:"
  }
}
