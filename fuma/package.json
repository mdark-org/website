{
  "name": "fuma",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:post": "node scripts/post-build.ts",
    "build:next": "next build",
    "build": "pnpm build:next && pnpm build:post",
    "typecheck": "tsc",
    "start": "next start",
    "standalone": "node .next/standalone/fuma/server.js",
    "db:gen": "pnpm drizzle-kit generate && node scripts/sync-d1-migration.ts",
    "db:mi": "pnpm drizzle-kit migrate",
    "d1:migrate:local": "cf d1 migrations apply 8e3e8697-7153-472c-97b5-9e7c1ef352c2 --local --persist-to .cloudflare/state --dir drizzle/d1",
    "d1:migrate:remote": "cf d1 migrations apply 8e3e8697-7153-472c-97b5-9e7c1ef352c2 --dir drizzle/d1",
    "dev:vinext": "vite dev",
    "build:vinext": "vinext-cloudflare deploy",
    "start:vinext": "vite preview",
    "deploy": "cf deploy --prebuilt --worker mdark-dev-response-store",
    "deploy:production": "vinext-cloudflare deploy && cf deploy --prebuilt --worker mdark-dev-sync && cf deploy --prebuilt --worker mdark-dev-response-store",
    "deploy:preview": "cf previews deploy --worker mdark-dev && cf previews deploy --prebuilt --worker mdark-dev-sync && cf previews deploy --prebuilt --worker mdark-dev-response-store"
  },
  "type": "module",
  "dependencies": {
    "algoliasearch": "^5.59.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@cloudflare/workers-response-store": "^1.0.0",
    "@content-collections/markdown": "^0.1.4",
    "@fuma-comment/react": "1.5.1",
    "@fuma-comment/server": "^1.5.1",
    "@next/third-parties": "16.2.6",
    "@repo/source": "workspace:*",
    "@uploadthing/react": "^7.3.3",
    "@vinext/cloudflare": "^1.0.0",
    "any-date-parser": "^2.2.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "catalog:drizzle",
    "feed": "^5.2.1",
    "fumadocs-core": "catalog:fumadocs",
    "fumadocs-ui": "catalog:fumadocs",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-html": "^9.0.5",
    "hono": "4.13.7",
    "lucide-react": "1.17.0",
    "micromatch": "^4.0.8",
    "next": "16.2.6",
    "p-limit": "^7.3.3",
    "postgres": "^3.4.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.11.0",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "uploadthing": "^7.7.4",
    "vfile": "^6.0.3",
    "vinext": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "zx": "^8.8.5",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/micromatch": "^4.0.10",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@types/serialize-javascript": "^5.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "aws4fetch": "^1.0.20",
    "cf": "1.0.0-beta.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "catalog:drizzle",
    "p-limit": "^7.2.0",
    "react-medium-image-zoom": "^5.4.5",
    "tailwindcss": "^4.3.3",
    "use-sync-external-store": "^1.7.0",
    "use-sync-external-store-with-selector": "^0.1.1",
    "vite": "8.3.0"
  }
}
